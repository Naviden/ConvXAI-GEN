# Export these variables in the shell; this file is not automatically loaded.
CONVXAI_USE_LLM=0
# For Azure, CONVXAI_MODEL is your deployment name.
CONVXAI_MODEL=gpt4
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-02-01
# Alternatively use OPENAI_API_KEY and set CONVXAI_MODEL to an available model.
# CONVXAI_AUDIT_PATH=runs/audit.jsonl
# CONVXAI_TRUST_MODELS=1
